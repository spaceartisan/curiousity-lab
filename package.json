{
  "name": "curiosity-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "test": "vitest run",
    "check": "npm run test && npm run build && node scripts/validate-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts e2e *.ts *.json *.html play companion insights docs README.md .github/workflows"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
